// calc.terra — Terra 计算器
// 输出平方表、斐波那契数列和质数

输出("=== 平方表 ===")
新建变量 平
计数循环 (9, 平)
    输出(到文本(平) + " x " + 到文本(平) + " = " + 到文本(平 * 平))
循环结束 ()

输出("")
输出("=== 斐波那契数列 ===")
新建变量 前项
前项 = 0
新建变量 当前
当前 = 1
新建变量 序
计数循环 (15, 序)
    输出("F(" + 到文本(序) + ") = " + 到文本(当前))
    新建变量 下一项
    下一项 = 前项 + 当前
    前项 = 当前
    当前 = 下一项
循环结束 ()

输出("")
输出("=== 质数检测 ===")
新建变量 n
计数循环 (30, n)
    如果 (n 大于等于 2)
        新建变量 是质数
        是质数 = 1
        新建变量 除数
        除数 = 2
        判断循环 (除数 * 除数 小于等于 n)
            如果 (n % 除数 等于 0)
                是质数 = 0
                跳出循环()
            如果结束
            除数 = 除数 + 1
        循环结束 ()
        如果 (是质数 等于 1)
            输出(到文本(n) + " 是质数")
        如果结束
    如果结束
循环结束 ()

输出("")
输出("calc done!")
