// draw.terra — Terra绘图演示
// 展示 GUI 绘图功能

清屏()
刷新()

// 画天空渐变背景（多个矩形叠加）
画矩形(0, 0, 取宽(), 取高(), 黑色)
画矩形(0, 0, 取宽(), 300, 蓝色)
刷新()

// 画太阳
画圆(850, 100, 50, 黄色)
刷新()

// 画草地
画矩形(0, 500, 取宽(), 268, 绿色)
刷新()

// 画房子
画矩形(200, 350, 200, 150, 红色)
画矩形(220, 400, 40, 100, 青色)
画矩形(340, 400, 40, 100, 青色)
刷新()

// 画屋顶
画矩形(180, 300, 240, 50, 紫色)
刷新()

// 画小树
画矩形(600, 420, 20, 80, 黄色)
画圆(610, 380, 60, 绿色)
刷新()

// 画月亮和星星
画圆(200, 100, 30, 白色)
画点(300, 80, 白色)
画点(500, 120, 白色)
画点(400, 50, 白色)
画点(700, 90, 白色)
刷新()

// 标题
画文字(350, 30, "Terra绘图演示", 白色)
刷新()

// 彩虹条
画矩形(100, 600, 100, 30, 红色)
画矩形(220, 600, 100, 30, 黄色)
画矩形(340, 600, 100, 30, 绿色)
画矩形(460, 600, 100, 30, 青色)
画矩形(580, 600, 100, 30, 蓝色)
画矩形(700, 600, 100, 30, 紫色)
刷新()
